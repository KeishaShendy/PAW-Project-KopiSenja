<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8"><title>Edit Menu - Kopi Senja</title><script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-800 font-sans flex h-screen overflow-hidden">
    <aside class="w-64 bg-[#111827] text-white flex flex-col h-full shadow-lg z-10 flex-shrink-0">
        <div class="p-6 flex items-center gap-3">
            <div class="bg-white text-[#111827] font-extrabold text-xl p-2 rounded-md">KS</div>
            <h1 class="text-xl font-bold tracking-wide">Kopi Senja</h1>
        </div>
        <nav class="flex-1 mt-4 px-4 space-y-2">
            <a href="/" class="block px-4 py-3 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition">Dasbor</a>
            <a href="/produk" class="block px-4 py-3 rounded-lg bg-gray-800 text-white font-semibold transition shadow-inner">Etalase Menu</a>
            <a href="/riwayat" class="block px-4 py-3 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition">Riwayat Promo</a>
            <a href="/pengaturan" class="block px-4 py-3 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition">Pengaturan</a>
        </nav>
    </aside>

    <main class="flex-1 h-full overflow-y-auto p-10">
        <a href="/produk" class="text-sm text-gray-500 font-bold hover:text-gray-800 mb-6 inline-block">← Kembali ke Etalase</a>
        
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 max-w-2xl">
            <div class="flex justify-between items-center mb-8">
                <h2 class="text-2xl font-bold text-gray-900">Edit Menu</h2>
                <span class="text-xs font-bold text-gray-400 bg-gray-100 px-3 py-1 rounded">ID: MNU-<%= menu.id %></span>
            </div>
            
            <form id="formEdit" class="flex flex-col gap-5">
                <input type="hidden" id="menuId" value="<%= menu.id %>">
                
                <!-- Tampilan Foto Lama -->
                <div class="w-full h-48 bg-gray-200 rounded-xl mb-4 overflow-hidden relative">
                    <img src="<%= menu.gambar %>" class="w-full h-full object-cover">
                </div>

                <div class="grid grid-cols-2 gap-5">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Nama Menu</label>
                        <input type="text" id="nama" value="<%= menu.nama %>" class="w-full border p-3 rounded-xl bg-gray-50 focus:border-blue-500 focus:outline-none" required>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Kategori</label>
                        <input type="text" id="kategori" value="<%= menu.kategori %>" class="w-full border p-3 rounded-xl bg-gray-50 focus:border-blue-500 focus:outline-none" required>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-5">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Harga (Rp)</label>
                        <input type="number" id="harga" value="<%= menu.harga %>" class="w-full border p-3 rounded-xl bg-gray-50 focus:border-blue-500 focus:outline-none" required>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Stok (Cup/Porsi)</label>
                        <input type="number" id="stok" value="<%= menu.stok %>" class="w-full border p-3 rounded-xl bg-gray-50 focus:border-blue-500 focus:outline-none" required>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">URL Foto Produk</label>
                    <input type="text" id="gambar" value="<%= menu.gambar %>" class="w-full border p-3 rounded-xl bg-gray-50 focus:border-blue-500 focus:outline-none" required>
                </div>

                <div class="flex justify-end gap-3 mt-4 pt-4 border-t border-gray-100">
                    <a href="/produk" class="px-6 py-3 font-bold text-gray-500 hover:text-gray-800 transition">Batal</a>
                    <button type="submit" class="bg-amber-500 text-white px-8 py-3 rounded-xl font-bold hover:bg-amber-600 transition shadow-md">Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </main>

    <script>
        document.getElementById('formEdit').addEventListener('submit', async (e) => {
            e.preventDefault();
            const id = document.getElementById('menuId').value;
            const res = await fetch(`/api/produk/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    kategori: document.getElementById('kategori').value,
                    nama: document.getElementById('nama').value,
                    harga: document.getElementById('harga').value,
                    stok: document.getElementById('stok').value,
                    gambar: document.getElementById('gambar').value
                })
            });
            if(res.ok) window.location.href = '/produk';
        });
    </script>
</body>
</html>