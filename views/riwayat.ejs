<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Riwayat Promo - Kopi Senja</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-800 font-sans flex h-screen overflow-hidden">
    <!-- SIDEBAR -->
    <aside class="w-64 bg-[#111827] text-white flex flex-col h-full shadow-lg z-10 flex-shrink-0">
        <div class="p-6 flex items-center gap-3">
            <div class="bg-white text-[#111827] font-extrabold text-xl p-2 rounded-md">KS</div>
            <h1 class="text-xl font-bold tracking-wide">Kopi Senja</h1>
        </div>
        <nav class="flex-1 mt-4 px-4 space-y-2">
            <a href="/" class="block px-4 py-3 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition">Dasbor</a>
            <a href="/produk" class="block px-4 py-3 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition">Etalase Menu</a>
            <a href="/riwayat" class="block px-4 py-3 rounded-lg bg-gray-800 text-white font-semibold transition shadow-inner">Riwayat Promo</a>
            <a href="/pengaturan" class="block px-4 py-3 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition">Pengaturan</a>
        </nav>
    </aside>

    <!-- KONTEN -->
    <main class="flex-1 h-full overflow-y-auto p-10">
        <div class="mb-8">
            <h2 class="text-3xl font-bold text-gray-900 mb-1">Riwayat Generasi Teks</h2>
            <p class="text-gray-500 text-sm">Daftar riwayat caption promosi yang telah dibuat oleh AI.</p>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50 border-b border-gray-100">
                    <tr>
                        <th class="p-4 font-bold text-gray-700 text-sm">Waktu</th>
                        <th class="p-4 font-bold text-gray-700 text-sm">Menu Terkait</th>
                        <th class="p-4 font-bold text-gray-700 text-sm">Platform</th>
                        <th class="p-4 font-bold text-gray-700 text-sm">Cuplikan Caption</th>
                        <th class="p-4 font-bold text-gray-700 text-sm text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                    <% if (histories.length === 0) { %>
                        <tr>
                            <td colspan="5" class="p-8 text-center text-gray-400 font-medium">
                                Belum ada riwayat promosi. Buat promo AI pertama Anda di halaman Etalase Menu!
                            </td>
                        </tr>
                    <% } else { %>
                        <% histories.forEach((item, index) => { %>
                        <tr class="hover:bg-slate-50/50 transition">
                            <td class="p-4 text-gray-500 whitespace-nowrap"><%= item.waktu %></td>
                            <td class="p-4 font-bold text-gray-900 whitespace-nowrap"><%= item.menu %></td>
                            <td class="p-4">
                                <span class="bg-sky-100 text-sky-700 px-3 py-1 rounded-full font-bold text-xs"><%= item.platform %></span>
                            </td>
                            <td class="p-4 text-gray-600 truncate max-w-md"><%= item.caption %></td>
                            <td class="p-4 text-center">
                                <textarea id="caption-<%= index %>" class="hidden"><%= item.caption %></textarea>
                                <button data-index="<%= index %>" onclick="copyCaption(this)" class="font-bold text-blue-600 hover:text-blue-800">Copy</button>
                            </td>
                        </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
            <div class="p-4 text-center bg-slate-50 text-gray-400 text-xs font-bold border-t border-gray-100">
                Menampilkan <%= histories.length %> riwayat tersimpan
            </div>
        </div>
    </main>

    <script>
        function copyCaption(button) {
            const index = button.getAttribute('data-index');
            const text = document.getElementById(`caption-${index}`).value;
            navigator.clipboard.writeText(text);
            alert('✨ Caption berhasil disalin!');
        }
    </script>
</body>
</html>