<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Katalog Menu - Kopi Senja</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 font-sans">
    
    <nav class="bg-[#0f172a] text-gray-300 p-4 shadow-md">
        <div class="container mx-auto flex gap-6 px-4 text-sm font-medium">
            <a href="/" class="hover:text-white transition">Dasbor</a>
            <a href="/produk" class="text-white font-bold border-b-2 border-white pb-1">Etalase Menu</a>
        </div>
    </nav>

    <div class="text-center mt-12 mb-8 relative">
        <h1 class="text-3xl font-bold text-gray-800 mb-2">Katalog Menu</h1>
        <!-- Tombol Tambah Menu -->
        <a href="/produk/tambah" class="inline-block mt-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2 rounded-lg shadow-sm transition">+ Tambah Menu Baru</a>
    </div>

    <div class="container mx-auto px-6 mb-20 max-w-6xl">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            
            <% menus.forEach(menu => { %>
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-shadow p-5 flex flex-col border border-gray-100">
                <div class="w-full h-48 bg-gray-100 rounded-xl mb-4 overflow-hidden">
                    <img src="<%= menu.gambar %>" alt="<%= menu.nama %>" class="w-full h-full object-cover">
                </div>
                
                <p class="text-[11px] text-gray-400 font-bold uppercase tracking-wider mb-1"><%= menu.kategori %></p>
                <h2 class="text-lg font-bold text-gray-800 mb-2"><%= menu.nama %></h2>
                <p class="text-xl font-extrabold text-emerald-500 mb-1">Rp <%= menu.harga %></p>
                <p class="text-xs text-red-500 mb-4 font-medium">Stok: <%= menu.stok %> cup</p>
                
                <div class="mt-auto flex gap-2">
                    <a href="/produk/edit/<%= menu.id %>" class="flex-1 bg-amber-500 hover:bg-amber-600 text-white text-center text-sm font-semibold py-2 rounded-lg transition shadow-sm">Edit</a>
                    <button onclick="hapusMenu('<%= menu.id %>')" class="flex-1 bg-red-500 hover:bg-red-600 text-white text-center text-sm font-semibold py-2 rounded-lg transition shadow-sm">Hapus</button>
                </div>
            </div>
            <% }) %>

        </div>
    </div>

    <script>
        async function hapusMenu(id) {
            if(confirm('Yakin ingin menghapus data menu ini?')) {
                const response = await fetch(`/api/produk/${id}`, { method: 'DELETE' });
                if(response.ok) window.location.reload();
            }
        }
    </script>
</body>
</html>